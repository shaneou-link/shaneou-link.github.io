---
import Layout from '../../components/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const all = await getCollection('projects', ({ data }) => !data.draft);
const projects = all.sort((a, b) => {
  // Manual order first, then startDate desc
  if (a.data.order !== b.data.order) return a.data.order - b.data.order;
  return b.data.startDate.valueOf() - a.data.startDate.valueOf();
});
---

<Layout title="Projects" description="Shane.O 在 GitHub 上的开源项目。">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Projects</p>
      <h1>开源项目</h1>
      <p class="muted" style="max-width: 60ch;">
        我在 GitHub 上维护的一些项目，涵盖后端基础设施、AI 工具与学习练手。
      </p>

      {projects.length === 0 ? (
        <p class="muted" style="margin-top: 2rem;">
          暂无项目。在 <code>src/content/projects/</code> 下新建 <code>.md</code> 文件即可添加。
        </p>
      ) : (
        <div class="project-list" style="margin-top: 2rem;">
          {projects.map((p) => <ProjectCard project={p} />)}
        </div>
      )}
    </div>
  </section>
</Layout>
